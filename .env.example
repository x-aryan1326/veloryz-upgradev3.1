# Configure values through hosted runtime environment settings. Never commit secrets.
ADMIN_EMAIL=
# PBKDF2 SHA-256: iterations:salt-hex:hash-hex. Password itself is never stored.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Live adviser replies require the OpenAI Developers key provisioning workflow.
OPENAI_API_KEY=
# Optional, server-owned model selection. Default: gpt-4.1-mini.
OPENAI_MODEL=

# Gemini is the default provider. Owner can also connect a key in /admin.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# GOOGLE_API_KEY is accepted as an alternative runtime variable.
